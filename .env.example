# Copy this file to .env.local and replace every placeholder with environment-specific values.
# Never commit .env.local or any production credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_COOKIE_SECURE=false
PGSSL=false
SERIAL_SECRET=replace-with-a-long-random-serial-secret
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SAAS_BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret
ALLOW_DEV_DEFAULT_TENANT=false
DEV_DEFAULT_COMPANY_SLUG=your-company-slug
